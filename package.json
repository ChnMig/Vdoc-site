    "prettier": "^3.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
