{
  "name": "vdoc-site",
  "private": true,
  "version": "0.3.17-beta.25",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "workspace:sync": "node scripts/sync-workspace.mjs",
    "workspace:check": "node scripts/sync-workspace.mjs --check",
    "workspace:package": "bash scripts/package-workspace.sh",
    "site:package": "bash scripts/package-site.sh",
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "build:root": "VITEPRESS_BASE=/ vitepress build docs",
    "build:pages": "VITEPRESS_BASE=/Vdoc-site/ vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/vitepress-structure.test.ts tests/code-color-compaction.test.ts",
    "test:content": "vitest run tests/contracts",
    "test:browser": "playwright test tests/browser/routes.spec.ts tests/browser/interactions.desktop.spec.ts tests/browser/interactions.mobile.spec.ts",
    "test:browser:root": "pnpm build:root && pnpm check:budget && PLAYWRIGHT_BASE_PATH=/ pnpm test:browser",
    "test:browser:pages": "pnpm build:pages && pnpm check:budget && PLAYWRIGHT_BASE_PATH=/Vdoc-site/ pnpm test:browser",
    "test:performance": "playwright test tests/browser/performance.spec.ts --workers=1",
    "test:performance:root": "pnpm build:root && pnpm check:budget && PLAYWRIGHT_BASE_PATH=/ pnpm test:performance",
    "test:performance:pages": "pnpm build:pages && pnpm check:budget && PLAYWRIGHT_BASE_PATH=/Vdoc-site/ pnpm test:performance",
    "check:budget": "node scripts/check-build-budget.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
