# Copy this file to .env, replace every placeholder secret, then run:
#   docker compose --env-file .env up --build

# Host ports published by Docker Compose. They bind to loopback by default so a
# disposable stack is not exposed to the LAN. Set 0.0.0.0 only deliberately.
VDOC_PUBLISH_ADDRESS=127.0.0.1
VDOC_POSTGRES_HOST_PORT=5432
VDOC_RUSTFS_HOST_PORT=9000
VDOC_RUSTFS_CONSOLE_HOST_PORT=9001
VDOC_BACKEND_HOST_PORT=8080
VDOC_ADMIN_HOST_PORT=8081

# Backend container port. Keep this as 8080 unless you also need the backend to listen
# on a different port inside its container.
VDOC_BACKEND_CONTAINER_PORT=8080

# Build provenance embedded in the backend/Admin binaries and OCI labels. These
# values correspond to the repository commits in workspace.lock.json. Refresh
# them together with the lock; release checks reject dev/unknown or mismatches.
VDOC_BACKEND_VERSION=v0.3.0
VDOC_BACKEND_GIT_COMMIT=7694404f949d1110ad8e2dcce4bb63b2bd97e63f
VDOC_BACKEND_BUILD_TIME=2026-09-16T13:16:58+08:00
VDOC_ADMIN_VERSION=v0.3.0
VDOC_ADMIN_GIT_COMMIT=1e675e981769444bc5464e5a7d18d11c12dc241d
VDOC_ADMIN_BUILD_TIME=2026-09-16T13:16:58+08:00

# Browser-facing backend origin. This is what Admin users' browsers can reach.
# If VDOC_BACKEND_HOST_PORT changes, update this URL too.
VDOC_BACKEND_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Admin runtime API URL. This is written to /runtime-config.js when the admin
# container starts. It must be browser-facing, not http://backend:8080, because
# user browsers cannot resolve Docker Compose service names.
VDOC_ADMIN_API_BASE_URL=http://127.0.0.1:8080
# Exact browser origins allowed to call the backend. If VDOC_ADMIN_HOST_PORT
# changes, update both values before recreating the backend container.
VDOC_SERVER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

# Anonymous HTTP registration is disabled by default. Production deployments
# should keep this false and configure the initial admin below.
VDOC_AUTH_ALLOW_REGISTRATION=false
VDOC_AUTH_RATE_LIMIT=2
VDOC_AUTH_RATE_BURST=5

# PostgreSQL credentials used by the postgres service and by the backend DSN.
# For VDOC_POSTGRES_PASSWORD, avoid URI-reserved characters unless percent-encoded.
VDOC_POSTGRES_DB=vdoc
VDOC_POSTGRES_USER=vdoc
VDOC_POSTGRES_PASSWORD=replace-with-local-postgres-password
VDOC_TEST_POSTGRES_DB=vdoc_e2e

# RustFS/S3 credentials used by rustfs and the backend object storage client.
VDOC_STORAGE_BUCKET=vdoc
VDOC_STORAGE_ACCESS_KEY=replace-with-local-rustfs-access-key
VDOC_STORAGE_SECRET_KEY=replace-with-local-rustfs-secret-key

# Backend security secrets. Replace before running anything beyond a disposable
# local demo. Values must be at least 32 characters where noted by backend checks.
VDOC_JWT_KEY=replace-with-at-least-32-characters-jwt-key
VDOC_MCP_TOKEN_CIPHER_KEY=replace-with-at-least-32-characters-mcp-key
VDOC_MCP_TOKEN_CIPHER_KID=local-aes-gcm-v1
# JSON object of historical KID -> key entries kept only during rotation.
VDOC_MCP_TOKEN_CIPHER_KEYRING={}

# First admin account for a fresh deployment. Required unless you explicitly
# enable disposable/pilot registration above. It is created only for an empty DB.
VDOC_INITIAL_ADMIN_EMAIL=
VDOC_INITIAL_ADMIN_NAME=
VDOC_INITIAL_ADMIN_PASSWORD=

# Optional service-level settings.
TZ=Asia/Shanghai
VDOC_RUSTFS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:9001,http://localhost:9001
VDOC_RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:9001,http://localhost:9001
VDOC_RUSTFS_LOG_LEVEL=info
